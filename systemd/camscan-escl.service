[Unit]
Description=camscan-escl — eSCL daemon presenting a USB webcam as a scanner
After=network.target

[Service]
Type=simple
# If installed with pipx or `uv pip install --user`. When running from a
# project venv instead, point this at that interpreter, e.g.
#   ExecStart=%h/Code/Projects/WebCamScanner/.venv/bin/python -m camscan_escl
# %h is not expanded inside a venv path by anything else, so write it out.
ExecStart=%h/.local/bin/camscan-escl
Restart=on-failure
RestartSec=5
# The capture command needs the camera; nothing else needs privilege.
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/camscan-escl

[Install]
WantedBy=default.target
